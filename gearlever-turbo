def zsync_update_available(file_path: Path) -> tuple[Optional[bool], str]:
    """Return (True/False/None, detail). None means check failed."""
    tool = shutil.which("appimageupdatetool")
    if not tool:
        return None, "appimageupdatetool not found"
    try:
        proc = subprocess.run(
            [tool, "--check-for-update", str(file_path)],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, str(exc)
    # Convention: 0 = update available, 1 = up to date
    if proc.returncode == 0:
        return True, (proc.stdout or proc.stderr or "update available").strip()
    if proc.returncode == 1:
        return False, (proc.stdout or proc.stderr or "up to date").strip()
    return None, (proc.stderr or proc.stdout or f"exit {proc.returncode}").strip()


def apply_zsync_update(file_path: Path) -> None:
    tool = shutil.which("appimageupdatetool")
    if not tool:
        raise RuntimeError("appimageupdatetool is required for zsync updates but was not found")
    proc = subprocess.run(
        [tool, "--overwrite", str(file_path)],
        capture_output=True,
        text=True,
        timeout=3600,
        check=False,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"appimageupdatetool failed for {file_path}: "
            f"{(proc.stderr or proc.stdout or '').strip()}"
        )
    # Ensure executable bit (GearLever expects this)
    file_path.chmod(file_path.stat().st_mode | 0o111)


# ---------------------------------------------------------------------------
# aria2 downloads + atomic replace
# ---------------------------------------------------------------------------


def require_aria2c() -> str:
    path = shutil.which("aria2c")
    if not path:
        raise FileNotFoundError(
            f"aria2c not found on PATH. Install it with: {aria2_install_hint()}"
        )
    return path


def write_aria2_input(updates: list[PendingUpdate], staging_dir: Path) -> Path:
    """Write aria2 input file. Each download lands as <hash>.partial in staging_dir."""
    input_path = staging_dir / ARIA2_INPUT_NAME
    lines: list[str] = []
    for upd in updates:
        assert upd.download_url
        out_name = f"{upd.app.app_hash}.appimage"
        lines.append(upd.download_url)
        lines.append(f"  dir={staging_dir}")
        lines.append(f"  out={out_name}")
        lines.append("")
    input_path.write_text("\n".join(lines), encoding="utf-8")
    return input_path


def run_aria2(
    updates: list[PendingUpdate],
    *,
    jobs: int,
    connections: int,
    staging_dir: Path,
) -> None:
    aria2c = require_aria2c()
    staging_dir.mkdir(parents=True, exist_ok=True)
    input_path = write_aria2_input(updates, staging_dir)
    # error: hide NOTICE redirect spam; interactive keeps compact progress readout
    interactive = (not _quiet) and sys.stdout.isatty()
    cmd = [
        aria2c,
        f"--input-file={input_path}",
        f"--max-concurrent-downloads={jobs}",
        f"--max-connection-per-server={connections}",
        f"--split={connections}",
        "--min-split-size=1M",
        "--continue=true",
        "--auto-file-renaming=false",
        "--allow-overwrite=true",
        f"--user-agent={USER_AGENT}",
        "--console-log-level=error",
        "--summary-interval=1" if interactive else "--summary-interval=0",
        "--show-console-readout=true" if interactive else "--show-console-readout=false",
    ]
    section_header("Downloading")
    log(
        f"Fetching {len(updates)} file(s) with aria2c "
        f"(jobs={jobs}, connections/server={connections})…"
    )
    proc = subprocess.run(cmd, check=False)
    if proc.returncode not in (0,):
        # aria2 exit 0 = all success; non-zero may still have partial successes
        raise RuntimeError(f"aria2c exited with code {proc.returncode}")


def atomic_replace(src: Path, dest: Path) -> None:
    """Replace dest with src atomically (same filesystem). Keep dest mode+x."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    # Stage beside destination so os.replace is atomic on the same volume
    partial = dest.with_name(dest.name + PARTIAL_SUFFIX)
    if partial.exists():
        partial.unlink()
    shutil.move(str(src), str(partial))
    partial.chmod(partial.stat().st_mode | 0o111)
    os.replace(partial, dest)


def finalize_aria2_downloads(updates: list[PendingUpdate], staging_dir: Path) -> list[str]:
    """Move staged downloads onto GearLever paths. Returns error messages."""
    errors: list[str] = []
    for upd in updates:
        staged = staging_dir / f"{upd.app.app_hash}.appimage"
        if not staged.is_file():
            errors.append(f"{upd.app.name}: download missing ({staged.name})")
            continue
        # Basic AppImage sanity: non-trivial size
        if staged.stat().st_size < 1024:
            errors.append(f"{upd.app.name}: downloaded file too small")
            staged.unlink(missing_ok=True)
            continue
        try:
            atomic_replace(staged, upd.app.file_path)
            if _verbose:
                log(f"  Updated {upd.app.name} → {upd.app.file_path}")
        except OSError as exc:
            errors.append(f"{upd.app.name}: failed to install: {exc}")
    return errors


