VERSION = "1.1.0"
GITHUB_REPO = "Mystery2099/gearlever-turbo"
GITHUB_URL = f"https://github.com/{GITHUB_REPO}"
SELF_UPDATE_URL = (
    f"https://raw.githubusercontent.com/{GITHUB_REPO}/master/gearlever-turbo"
)
USER_AGENT = f"gearlever-turbo/{VERSION} (+{GITHUB_URL}; GearLever companion)"
FLATPAK_APP_ID = "it.mijorus.gearlever"
PARTIAL_SUFFIX = ".turbo-partial"
SELF_UPDATE_SUFFIX = ".turbo-self-update"
ARIA2_INPUT_NAME = "gearlever-turbo-aria2.txt"

EXIT_OK = 0
EXIT_PARTIAL = 1
EXIT_SETUP = 2

RE_X86 = re.compile(r"(\-|\_|\.)x86(\-|\_|\.)")
RE_ARM = re.compile(r"(\-|\_|\.)(arm64|aarch64|armv7l)(\-|\_|\.)")
RE_GH_EMBEDDED = re.compile(r"gh-releases-zsync\|.*\.zsync")
RE_STATIC_EMBEDDED = re.compile(r"\szsync\|http\S*")
RE_SHA1 = re.compile(r"SHA-1:\s*([0-9a-f]{40})", re.I)
RE_ZSYNC_URL = re.compile(r"URL:\s*(.*)")
RE_SCRIPT_VERSION = re.compile(
    r'^VERSION\s*=\s*["\']([^"\']+)["\']', re.MULTILINE
)

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------

_quiet = False
_verbose = False
_topgrade = False
_use_color = False

# ANSI (only when _use_color)
_C_RESET = "\033[0m"
_C_GREEN = "\033[32m"
_C_CYAN = "\033[36m"
_C_RED = "\033[31m"
_C_YELLOW = "\033[33m"
_C_DIM = "\033[2m"
_C_BOLD = "\033[1m"


def _enable_color(*, quiet: bool) -> None:
    """Enable ANSI colors on a TTY unless quiet or NO_COLOR is set."""
    global _use_color
    if quiet or os.environ.get("NO_COLOR"):
        _use_color = False
        return
    _use_color = sys.stdout.isatty()


def _paint(text: str, color: str) -> str:
    if not _use_color:
        return text
    return f"{color}{text}{_C_RESET}"


def log(msg: str = "") -> None:
    if not _quiet:
        print(msg, flush=True)


def log_err(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def topgrade_line(msg: str) -> None:
    """Always print to stdout (used for --topgrade one-line summaries)."""
    print(msg, flush=True)


def section_header(title: str, width: int = 52) -> None:
    """Nala-like section rule. No-op when quiet."""
    if _quiet:
        return
    bar = "─" * max(4, width - len(title) - 4)
    log(_paint(f"── {title} {bar}", _C_BOLD if _use_color else ""))


def status_tag(kind: str) -> str:
    """Colored status label for resolve output."""
    labels = {
        "OK": ("OK      ", _C_GREEN),
        "UPDATE": ("Updating", _C_CYAN),
        "SKIP": ("SKIP    ", _C_YELLOW),
        "ERROR": ("ERROR   ", _C_RED),
    }
    text, color = labels.get(kind, (kind, ""))
    return _paint(f"  {text}", color) if color else f"  {text}"


# ---------------------------------------------------------------------------
# Dependency / install hints
# ---------------------------------------------------------------------------


def aria2_install_hint() -> str:
    """Best-effort distro package hint for aria2."""
    if shutil.which("apt-get") or shutil.which("apt"):
        return "sudo apt install aria2"
    if shutil.which("dnf"):
        return "sudo dnf install aria2"
    if shutil.which("pacman"):
        return "sudo pacman -S aria2"
    if shutil.which("zypper"):
        return "sudo zypper install aria2"
    if shutil.which("apk"):
        return "sudo apk add aria2"
    return "install the aria2 package for your distribution"


def appimageupdatetool_hint() -> str:
    return (
        "install appimageupdatetool (AppImageUpdate) for faster delta updates; "
        "without it, full downloads are used when possible"
    )


def run_preflight(apps: list[ManagedApp]) -> tuple[bool, bool]:
    """Print compact dependency status. Returns (has_aria2, has_zsync_tool)."""
    has_aria2 = shutil.which("aria2c") is not None
    has_zsync = shutil.which("appimageupdatetool") is not None
    zsync_capable = any(
        a.embedded_upd_info and "zsync" in a.embedded_upd_info.lower() for a in apps
    )
    has_problems = (not has_aria2) or (zsync_capable and not has_zsync)

    if _verbose or has_problems:
        log("Dependencies:")
        if has_aria2:
            log(f"  {_paint('OK', _C_GREEN)}     aria2c found")
        else:
            log(
                f"  {_paint('WARN', _C_YELLOW)}   aria2c not found — "
                f"needed for full downloads ({aria2_install_hint()})"
            )
        if has_zsync:
            log(f"  {_paint('OK', _C_GREEN)}     appimageupdatetool found")
        elif zsync_capable:
            log(
                f"  {_paint('WARN', _C_YELLOW)}   appimageupdatetool not found — "
                f"will fall back to full downloads"
            )
            log(f"           {_paint(appimageupdatetool_hint(), _C_DIM)}")
        else:
            log(f"  {_paint('OK', _C_DIM)}     appimageupdatetool optional (not needed yet)")
    else:
        bits: list[str] = [_paint("aria2c", _C_GREEN)]
        if has_zsync:
            bits.append(_paint("appimageupdatetool", _C_GREEN))
        log("Deps: " + " · ".join(bits))

    return has_aria2, has_zsync


