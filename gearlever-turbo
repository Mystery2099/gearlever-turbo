#!/usr/bin/env python3
"""gearlever-turbo — parallel AppImage update accelerator for GearLever.

Companion script only: reads GearLever metadata, resolves updates concurrently,
downloads with aria2c (or appimageupdatetool for embedded zsync), and replaces
files where GearLever already expects them.
"""

