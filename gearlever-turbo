# CLI
# ---------------------------------------------------------------------------


def format_size(num: Optional[int]) -> str:
    if not num:
        return "?"
    for unit in ("B", "KiB", "MiB", "GiB"):
        if num < 1024 or unit == "GiB":
            return f"{num:.0f} {unit}" if unit == "B" else f"{num:.1f} {unit}"
        num /= 1024
    return f"{num:.1f} GiB"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="gearlever-turbo",
        description=(
            "Parallel update accelerator for GearLever AppImages. "
            "Reads GearLever metadata, resolves updates concurrently, "
            "and downloads with aria2c (or appimageupdatetool for zsync)."
        ),
    )
    p.add_argument("--dry-run", action="store_true", help="Show pending updates without downloading")
    p.add_argument("--quiet", "-q", action="store_true", help="Quiet mode (errors still printed)")
    p.add_argument(
        "--jobs",
        "-j",
        type=int,
        default=4,
        help="Parallel resolve workers / concurrent aria2 downloads (default: 4)",
    )
    p.add_argument(
        "--connections",
        "-x",
        type=int,
        default=16,
        help="aria2 connections per server (default: 16)",
    )
    p.add_argument(
        "--config-dir",
        type=Path,
        help="Override GearLever config directory (contains gearlever.conf)",
    )
    p.add_argument("--version", action="version", version=f"gearlever-turbo {VERSION}")
    return p


def main(argv: Optional[list[str]] = None) -> int:
    global _quiet
    args = build_parser().parse_args(argv)
    _quiet = bool(args.quiet)

    if args.jobs < 1 or args.connections < 1:
        log_err("--jobs and --connections must be >= 1")
        return EXIT_SETUP

    # Locate GearLever data
    if args.config_dir:
        config_dirs = [args.config_dir.expanduser()]
        if not (config_dirs[0] / "gearlever.conf").is_file() and not (
            config_dirs[0] / "apps.json"
        ).is_file():
            log_err(f"No gearlever.conf or apps.json in {config_dirs[0]}")
            return EXIT_SETUP
    else:
        config_dirs = find_gearlever_config_dirs()
        if not config_dirs:
            log_err(
                "GearLever data not found.\n"
                "Expected gearlever.conf under:\n"
                f"  ~/.var/app/{FLATPAK_APP_ID}/config/\n"
                "  ~/.config/\n"
                "Install/open GearLever once, or pass --config-dir."
            )
            return EXIT_SETUP

    config_dir = config_dirs[0]
    log(f"Using GearLever config: {config_dir}")

    try:
        apps = parse_gearlever_apps(config_dir)
    except Exception as exc:  # noqa: BLE001
        log_err(f"Failed to parse GearLever metadata: {exc}")
        return EXIT_SETUP

    if not apps:
        log("No managed AppImages found in GearLever config.")
        return EXIT_OK

    log(f"Found {len(apps)} managed AppImage(s). Resolving updates…")

    results = resolve_all(apps, jobs=args.jobs)

    pending: list[PendingUpdate] = []
    errors = 0
    up_to_date = 0
    no_source = 0

    for res in results:
        label = res.app.name
        if res.error:
            errors += 1
            log_err(f"  ERROR  {label}: {res.error}")
            continue
        if res.skipped:
            if res.skipped.startswith("up to date"):
                up_to_date += 1
                log(f"  OK     {label}: {res.skipped}")
            else:
                no_source += 1
                log(f"  SKIP   {label}: {res.skipped}")
            continue
        if res.update:
            pending.append(res.update)
            size = format_size(res.update.remote_size)
            log(f"  UPDATE {label}: {res.update.detail} [{res.update.method}, {size}]")

    log()
    log(
        f"Summary: {len(pending)} to update, {up_to_date} up to date, "
        f"{no_source} skipped, {errors} errors"
    )

    if not pending:
        return EXIT_PARTIAL if errors else EXIT_OK

    if args.dry_run:
        log("Dry run — no downloads performed.")
        return EXIT_PARTIAL if errors else EXIT_OK

    # Split zsync vs aria2
    zsync_updates = [u for u in pending if u.method == "zsync"]
    aria_updates = [u for u in pending if u.method == "aria2"]

    apply_errors: list[str] = []

    for upd in zsync_updates:
        log(f"Delta-updating {upd.app.name} with appimageupdatetool…")
        try:
            apply_zsync_update(upd.app.file_path)
            log(f"  Updated {upd.app.name} (zsync)")
        except RuntimeError as exc:
            apply_errors.append(str(exc))
            log_err(f"  ERROR  {exc}")

    if aria_updates:
        try:
            require_aria2c()
        except FileNotFoundError as exc:
            log_err(str(exc))
            return EXIT_SETUP

        staging = Path(tempfile.mkdtemp(prefix="gearlever-turbo-"))
        try:
            try:
                run_aria2(
                    aria_updates,
                    jobs=args.jobs,
                    connections=args.connections,
                    staging_dir=staging,
                )
            except RuntimeError as exc:
                log_err(str(exc))
                # Still try to finalize any completed files
            apply_errors.extend(finalize_aria2_downloads(aria_updates, staging))
        finally:
            shutil.rmtree(staging, ignore_errors=True)

    for msg in apply_errors:
        log_err(f"  ERROR  {msg}")

    if apply_errors or errors:
        return EXIT_PARTIAL

    log("All updates applied.")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
