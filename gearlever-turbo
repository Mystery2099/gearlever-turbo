def format_size(num: Optional[int]) -> str:
    if not num:
        return "?"
    value = float(num)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if value < 1024 or unit == "GiB":
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024
    return f"{value:.1f} GiB"


def total_pending_size(pending: list[PendingUpdate]) -> Optional[int]:
    sizes = [u.remote_size for u in pending if u.remote_size]
    if not sizes:
        return None
    return sum(sizes)


def print_download_plan(pending: list[PendingUpdate]) -> None:
    section_header("Plan")
    name_w = max((len(u.app.name) for u in pending), default=8)
    name_w = min(max(name_w, 8), 40)
    for upd in pending:
        size = format_size(upd.remote_size)
        method = "delta" if upd.method == "zsync" else "full download"
        log(f"  {upd.app.name:<{name_w}}  {method:<14}  {size}")
        if _verbose and upd.detail:
            log(f"  {'':<{name_w}}  {_paint(upd.detail, _C_DIM)}")
    total = total_pending_size(pending)
    log(f"  {'Total':<{name_w}}  {'':<14}  {format_size(total)}")
    log()


def confirm_download(pending: list[PendingUpdate], *, yes: bool) -> bool:
    """Return True to proceed. Quiet/yes/non-TTY skip the prompt."""
    if _quiet or yes or not sys.stdin.isatty():
        return True
    total = total_pending_size(pending)
    size_hint = format_size(total)
    prompt = (
        f"Do you want to continue? {len(pending)} update(s), ~{size_hint} [Y/n] "
    )
    try:
        answer = input(prompt).strip().lower()
    except EOFError:
        return True
    return answer in ("", "y", "yes")


def format_topgrade_summary(
    *,
    updated: list[str],
    failed: list[str],
    nothing: bool,
) -> str:
    if nothing and not failed:
        return "Nothing to update."
    parts: list[str] = []
    if updated:
        parts.append(f"Updated: {', '.join(updated)}.")
    if failed:
        parts.append(f"Failed: {'; '.join(failed)}.")
    if not parts:
        return "Nothing to update."
    return " ".join(parts)


def failure_tip(
    *,
    errors: int,
    no_source: int,
    apply_errors: list[str],
    resolve_errors: list[str],
    missing_aria2: bool,
) -> Optional[str]:
    """One-line tip for the most likely fix after a partial failure."""
    if missing_aria2:
        return f"Tip: install aria2 — {aria2_install_hint()}"
    joined = " ".join(resolve_errors + apply_errors).lower()
    if "rate limit" in joined:
        return "Tip: set GITHUB_TOKEN or GH_TOKEN and retry (GitHub API rate limits)."
    if (
        "http 403" in joined
        and "github" in joined
        and not (os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN"))
    ):
        return "Tip: set GITHUB_TOKEN or GH_TOKEN and retry (GitHub API rate limits)."
    if "network error" in joined or "tunnel" in joined:
        return "Tip: check your network connection and retry."
    if no_source and errors == 0 and not apply_errors:
        return "Tip: set an Update URL/provider in GearLever for skipped apps."
    if no_source and errors:
        return (
            "Tip: set Update URLs in GearLever for skipped apps; "
            "check network/token for errors."
        )
    if apply_errors:
        return "Tip: re-run after fixing the errors above; partial downloads are cleaned up."
    if errors:
        return "Tip: check network connectivity, or set GITHUB_TOKEN if using GitHub sources."
    return None


def build_parser() -> argparse.ArgumentParser:
    epilog = """examples:
  gearlever-turbo --check          # Resolve only (dry run)
  gearlever-turbo                  # Check, confirm, then download
  gearlever-turbo -v               # Show every OK / SKIP row
  gearlever-turbo --yes            # Download without prompting
  gearlever-turbo --topgrade       # Quiet one-line summary (Topgrade / cron)
  gearlever-turbo --self-update    # Update this script from GitHub
  gearlever-turbo --quiet          # Silent (errors still printed)

Environment:
  GITHUB_TOKEN / GH_TOKEN   Raise GitHub API rate limits
  NO_COLOR                  Disable ANSI colors
"""
    p = argparse.ArgumentParser(
        prog="gearlever-turbo",
        description=(
            "Parallel update accelerator for GearLever AppImages. "
            "Reads GearLever metadata, resolves updates concurrently, "
            "and downloads with aria2c (or appimageupdatetool for zsync)."
        ),
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--dry-run",
        "--check",
        dest="dry_run",
        action="store_true",
        help="Show pending updates without downloading (--check is an alias)",
    )
    p.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="Download without confirmation prompt",
    )
    p.add_argument(
        "--quiet",
        "-q",
        action="store_true",
        help="Quiet mode (errors still printed)",
    )
    p.add_argument(
        "--topgrade",
        action="store_true",
        help="Quiet + yes; print one summary line (for Topgrade / automation)",
    )
    p.add_argument(
        "--self-update",
        action="store_true",
        help="Update this script from GitHub (master) and exit",
    )
    p.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        help="Show every OK / SKIP row and extra detail",
    )
    p.add_argument(
        "--jobs",
        "-j",
        type=int,
        default=4,
        help="Parallel resolve workers / concurrent aria2 downloads (default: 4)",
    )
    p.add_argument(
        "--connections",
        "-x",
        type=int,
        default=16,
        help="aria2 connections per server (default: 16)",
    )
    p.add_argument(
        "--config-dir",
        type=Path,
        help="Override GearLever config directory (contains gearlever.conf)",
    )
    p.add_argument("--version", action="version", version=f"gearlever-turbo {VERSION}")
    return p


def main(argv: Optional[list[str]] = None) -> int:
    global _quiet, _verbose, _topgrade
    args = build_parser().parse_args(argv)
    _topgrade = bool(args.topgrade)
    _verbose = bool(args.verbose) and not _topgrade
    _quiet = bool(args.quiet) or _topgrade
    yes = bool(args.yes) or _topgrade
    _enable_color(quiet=_quiet)

    if args.self_update:
        return self_update(quiet=_quiet)

    if args.jobs < 1 or args.connections < 1:
        log_err("--jobs and --connections must be >= 1")
        return EXIT_SETUP

    # Locate GearLever data
    if args.config_dir:
        config_dirs = [args.config_dir.expanduser()]
        if not (config_dirs[0] / "gearlever.conf").is_file() and not (
            config_dirs[0] / "apps.json"
        ).is_file():
            log_err(f"No gearlever.conf or apps.json in {config_dirs[0]}")
            return EXIT_SETUP
    else:
        config_dirs = find_gearlever_config_dirs()
        if not config_dirs:
            log_err(
                "GearLever data not found.\n"
                "Expected gearlever.conf under:\n"
                f"  ~/.var/app/{FLATPAK_APP_ID}/config/\n"
                "  ~/.config/\n"
                "Install/open GearLever once, or pass --config-dir."
            )
            return EXIT_SETUP

    config_dir = config_dirs[0]
    if _verbose:
        log(f"Using GearLever config: {config_dir}")

    try:
        apps = parse_gearlever_apps(config_dir)
    except Exception as exc:  # noqa: BLE001
        log_err(f"Failed to parse GearLever metadata: {exc}")
        return EXIT_SETUP

    if not apps:
        if _topgrade:
            topgrade_line("Nothing to update.")
        else:
            log("No managed AppImages found in GearLever config.")
        return EXIT_OK

    has_aria2, _has_zsync = run_preflight(apps)
    section_header(f"Checking {len(apps)} AppImages")

    results = resolve_all(apps, jobs=args.jobs)

    pending: list[PendingUpdate] = []
    errors = 0
    up_to_date = 0
    no_source = 0
    resolve_error_msgs: list[str] = []
    failed_labels: list[str] = []

    for res in results:
        label = res.app.name
        if res.error:
            errors += 1
            resolve_error_msgs.append(res.error)
            failed_labels.append(f"{label} ({res.error})")
            log_err(f"{status_tag('ERROR')} {label}: {res.error}")
            continue
        if res.skipped:
            if res.skipped.startswith("up to date"):
                up_to_date += 1
                if _verbose:
                    log(f"{status_tag('OK')} {label}: {res.skipped}")
            else:
                no_source += 1
                if _verbose:
                    log(f"{status_tag('SKIP')} {label}: {res.skipped}")
            continue
        if res.update:
            pending.append(res.update)
            size = format_size(res.update.remote_size)
            method = res.update.method
            if _verbose:
                log(
                    f"{status_tag('UPDATE')} {label}: {res.update.detail} "
                    f"[{method}, {size}]"
                )
            else:
                log(f"{status_tag('UPDATE')} {label:<28} {size:>10}   {method}")

    # Collapsed counts (default / non-verbose)
    if not _quiet:
        bits: list[str] = []
        if up_to_date:
            bits.append(f"{up_to_date} up to date")
        if no_source:
            bits.append(f"{no_source} skipped (no update URL)")
        if errors:
            bits.append(f"{errors} errors")
        if bits and not _verbose:
            log("  " + _paint(" · ".join(bits), _C_DIM))
        elif _verbose:
            log()
            log(
                f"Summary: {len(pending)} to update, {up_to_date} up to date, "
                f"{no_source} skipped, {errors} errors"
            )

    if not pending:
        tip = failure_tip(
            errors=errors,
            no_source=no_source,
            apply_errors=[],
            resolve_errors=resolve_error_msgs,
            missing_aria2=False,
        )
        if tip and (errors or (no_source and _verbose)):
            log(tip)
        if _topgrade:
            topgrade_line(
                format_topgrade_summary(
                    updated=[],
                    failed=failed_labels,
                    nothing=True,
                )
            )
        return EXIT_PARTIAL if errors else EXIT_OK

    log()
    print_download_plan(pending)

    if args.dry_run:
        log("Dry run — no downloads performed.")
        tip = failure_tip(
            errors=errors,
            no_source=no_source,
            apply_errors=[],
            resolve_errors=resolve_error_msgs,
            missing_aria2=False,
        )
        if tip and (errors or no_source):
            log(tip)
        if _topgrade:
            names = [u.app.name for u in pending]
            topgrade_line(f"Would update: {', '.join(names)}.")
        return EXIT_PARTIAL if errors else EXIT_OK

    if not confirm_download(pending, yes=yes):
        log("Aborted — no downloads performed.")
        return EXIT_OK

    # Split zsync vs aria2
    zsync_updates = [u for u in pending if u.method == "zsync"]
    aria_updates = [u for u in pending if u.method == "aria2"]

    apply_errors: list[str] = []
    updated_names: list[str] = []
    missing_aria2 = False

    for upd in zsync_updates:
        log(f"Delta-updating {upd.app.name} with appimageupdatetool…")
        try:
            apply_zsync_update(upd.app.file_path)
            updated_names.append(upd.app.name)
            if _verbose:
                log(f"  Updated {upd.app.name} (zsync)")
        except RuntimeError as exc:
            apply_errors.append(str(exc))
            failed_labels.append(f"{upd.app.name} ({exc})")
            log_err(f"{status_tag('ERROR')} {exc}")

    if aria_updates:
        if not has_aria2:
            missing_aria2 = True
            msg = f"aria2c not found on PATH. Install it with: {aria2_install_hint()}"
            log_err(msg)
            apply_errors.append(msg)
            for upd in aria_updates:
                failed_labels.append(f"{upd.app.name} (aria2c missing)")
        else:
            staging = Path(tempfile.mkdtemp(prefix="gearlever-turbo-"))
            try:
                try:
                    run_aria2(
                        aria_updates,
                        jobs=args.jobs,
                        connections=args.connections,
                        staging_dir=staging,
                    )
                except RuntimeError as exc:
                    log_err(str(exc))
                    apply_errors.append(str(exc))
                    # Still try to finalize any completed files
                new_errs = finalize_aria2_downloads(aria_updates, staging)
                apply_errors.extend(new_errs)
                for msg in new_errs:
                    log_err(f"{status_tag('ERROR')} {msg}")
                    if ":" in msg:
                        failed_labels.append(msg.replace(": ", " (", 1) + ")")
                failed_names = {e.split(":", 1)[0] for e in new_errs if ":" in e}
                for upd in aria_updates:
                    if upd.app.name not in failed_names:
                        updated_names.append(upd.app.name)
            finally:
                shutil.rmtree(staging, ignore_errors=True)

    if apply_errors or errors:
        tip = failure_tip(
            errors=errors,
            no_source=no_source,
            apply_errors=apply_errors,
            resolve_errors=resolve_error_msgs,
            missing_aria2=missing_aria2,
        )
        if tip:
            log(tip)
        section_header("Done")
        if updated_names:
            log(f"Partially updated: {', '.join(updated_names)}")
        if _topgrade:
            topgrade_line(
                format_topgrade_summary(
                    updated=updated_names,
                    failed=failed_labels,
                    nothing=False,
                )
            )
        return EXIT_SETUP if missing_aria2 and not updated_names else EXIT_PARTIAL

    section_header("Done")
    if updated_names:
        log(f"All updates applied: {', '.join(updated_names)}")
    else:
        log("All updates applied.")
    if _topgrade:
        topgrade_line(
            format_topgrade_summary(
                updated=updated_names,
                failed=[],
                nothing=not updated_names,
            )
        )
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
